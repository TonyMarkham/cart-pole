# IDE
.idea/
.vscode/
.vsconfig

# Freecad
*.FCBak
*.FCStd1

# Rust: the workspace build dir (also holds the orchestrator stub's
# default frame output, target/orchestrator-frames/)
target/

# Python
__pycache__/
*.pyc
.venv/

# Runs: predict/val outputs (proposals, annotated JPGs, val reports)
runs/

# Datasets: the real trees' skeletons are tracked (yamls, folder
# placeholders); all data - frames, labels, caches - stays local.
# generated/ is regenerable by design; its own .gitignore keeps
# everything inside out.
datasets/*
!datasets/generated/
!datasets/real-1440/
!datasets/real-640/
!datasets/calibration/
datasets/real-*/data/labels.cache
datasets/calibration/data/labels.cache

# Capture sidecars (8K renders, marker crops, manifests, verification
# stats): the wip~ name also keeps them out of Unity's AssetDatabase
# (trailing-tilde folders are never imported).
wip~/

# macOS
.DS_Store
