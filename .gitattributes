# Binary formats: no line-by-line diff, no line-ending conversion, no text
# merge. Git already detects these from their content; listing them makes it
# certain for every future file of the type.
*.blend binary
*.exr   binary
*.fbx   binary
*.FCStd binary
*.npz binary
*.onnx  binary
*.pdf   binary
*.png   binary
*.pt    binary
*.stl   binary
*.xcf   binary
