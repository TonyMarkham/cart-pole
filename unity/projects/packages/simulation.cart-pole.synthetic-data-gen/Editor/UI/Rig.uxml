<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:ue="UnityEditor.UIElements">
    <ui:VisualElement class="rig-form">
        <ui:Label text="Cart-Pole Rig" class="section-title" />
        <ue:PropertyField binding-path="m_StepAsset" />
        <ue:PropertyField binding-path="m_Markers" />
        <ui:Label name="cart-empty-warning" class="warning" text="cart is empty — drop a robot-assembly part to rebind" />
        <ui:Label name="cart-unresolved-warning" class="warning" text="cart path does not resolve inside the assembly instance" />
        <ui:VisualElement name="cart-slot" />
        <ui:Label name="pole-empty-warning" class="warning" text="pole is empty — drop a robot-assembly part to rebind" />
        <ui:Label name="pole-unresolved-warning" class="warning" text="pole path does not resolve inside the assembly instance" />
        <ui:VisualElement name="pole-slot" />
        <ui:Label text="State Draw Bounds" class="group-title" />
        <ue:PropertyField binding-path="m_CartPositionRange" />
        <ue:PropertyField binding-path="m_PoleRotationRange" />
        <ue:PropertyField binding-path="m_DisableAnchorRenderer" />
        <ue:PropertyField binding-path="m_EnableAnchorCollider" />
        <ue:PropertyField binding-path="m_EnableOnStart" />
        <ui:Button name="save-button" text="Save" class="save-button" />
    </ui:VisualElement>
</ui:UXML>
